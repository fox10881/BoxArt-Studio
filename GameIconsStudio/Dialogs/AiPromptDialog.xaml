<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GameIconsStudio.Dialogs.AiPromptDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:GameIconsStudio.Controls"
    Title="{x:Bind Loc.AiDialogTitle, Mode=OneWay}"
    PrimaryButtonText="{x:Bind Loc.AiBtnGo, Mode=OneWay}"
    CloseButtonText="{x:Bind Loc.AiBtnCancel, Mode=OneWay}"
    DefaultButton="Primary">

    <StackPanel Spacing="12" MinWidth="420">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Border
                Width="36"
                Height="36"
                Background="{ThemeResource BrushPrimaryTint}"
                BorderBrush="{ThemeResource BrushPrimaryBorderSoft}"
                BorderThickness="1"
                CornerRadius="8">
                <c:LucideIcon
                    Kind="Sparkles"
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stroke="{ThemeResource BrushPrimary}"
                    StrokeThickness="1.8" />
            </Border>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource BrushMutedForeground}"
                TextWrapping="Wrap"
                Text="{x:Bind Loc.AiSubtitle, Mode=OneWay}" />
        </StackPanel>

        <TextBlock
            FontSize="12"
            FontWeight="SemiBold"
            Foreground="{ThemeResource BrushForeground}"
            Text="{x:Bind Loc.AiNameLabel, Mode=OneWay}" />
        <TextBox
            x:Name="AiNameTextBox"
            FontSize="13"
            Background="{ThemeResource BrushSubtle}"
            BorderBrush="{ThemeResource BrushInput}"
            BorderThickness="1"
            CornerRadius="6" />

        <TextBlock
            FontSize="12"
            FontWeight="SemiBold"
            Foreground="{ThemeResource BrushForeground}"
            Text="{x:Bind Loc.AiDescLabel, Mode=OneWay}" />
        <TextBox
            x:Name="AiDescriptionTextBox"
            FontSize="13"
            PlaceholderText="{x:Bind Loc.AiDescPlaceholder, Mode=OneWay}"
            Background="{ThemeResource BrushSubtle}"
            BorderBrush="{ThemeResource BrushInput}"
            BorderThickness="1"
            CornerRadius="6" />

        <TextBlock
            Margin="0,4,0,0"
            FontSize="12"
            FontWeight="SemiBold"
            Foreground="{ThemeResource BrushForeground}"
            TextWrapping="Wrap"
            Text="{x:Bind Loc.AiCopyAssets, Mode=OneWay}" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                Height="34"
                Padding="12,0"
                CornerRadius="8"
                Click="CopyIcon_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:LucideIcon
                        Kind="ImageUp"
                        Width="14"
                        Height="14"
                        Stroke="{ThemeResource BrushForeground90}"
                        StrokeThickness="1.8" />
                    <TextBlock Text="{x:Bind Loc.AiBtnCopyIcon, Mode=OneWay}" />
                </StackPanel>
            </Button>
            <Button
                Height="34"
                Padding="12,0"
                CornerRadius="8"
                Click="CopyPrompt_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <c:LucideIcon
                        Kind="Clipboard"
                        Width="14"
                        Height="14"
                        Stroke="{ThemeResource BrushForeground90}"
                        StrokeThickness="1.8" />
                    <TextBlock Text="{x:Bind Loc.AiBtnCopyPrompt, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock
            x:Name="CopyStatus"
            FontSize="11"
            Foreground="{ThemeResource BrushPrimary}"
            Visibility="Collapsed" />
    </StackPanel>
</ContentDialog>
