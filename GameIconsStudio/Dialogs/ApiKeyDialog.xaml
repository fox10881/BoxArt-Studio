<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GameIconsStudio.Dialogs.ApiKeyDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:GameIconsStudio.Controls"
    Title="SteamGridDB API"
    PrimaryButtonText="Save"
    CloseButtonText="Close"
    DefaultButton="Primary">

    <StackPanel Spacing="14" MinWidth="380">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Border
                Width="36"
                Height="36"
                Background="{ThemeResource BrushPrimaryTint}"
                BorderBrush="{ThemeResource BrushPrimaryBorderSoft}"
                BorderThickness="1"
                CornerRadius="8">
                <c:LucideIcon
                    Kind="Key"
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stroke="{ThemeResource BrushPrimary}"
                    StrokeThickness="1.8" />
            </Border>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="13"
                Foreground="{ThemeResource BrushMutedForeground}"
                TextWrapping="Wrap"
                Text="Paste your SteamGridDB API key to enable automatic cover matching." />
        </StackPanel>

        <TextBox
            x:Name="ApiKeyBox"
            FontFamily="Cascadia Mono, Consolas"
            FontSize="12"
            PlaceholderText="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
            Background="{ThemeResource BrushSubtle}"
            BorderBrush="{ThemeResource BrushInput}"
            BorderThickness="1"
            CornerRadius="6" />

        <TextBlock
            x:Name="StatusText"
            FontSize="11"
            Foreground="{ThemeResource BrushStatusWarn}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <Grid Margin="0,4,0,0">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <HyperlinkButton
                    NavigateUri="https://www.steamgriddb.com/register"
                    Content="Register Account"
                    FontSize="12" />
                <HyperlinkButton
                    NavigateUri="https://www.steamgriddb.com/profile/preferences/api"
                    Content="Get API Key"
                    FontSize="12" />
            </StackPanel>
            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource BrushMutedFg80}"
                Text="stored locally on this PC" />
        </Grid>
    </StackPanel>
</ContentDialog>
