<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GameIconsStudio.Dialogs.DebugLogDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:GameIconsStudio.Controls"
    Title="{x:Bind Loc.DebugTitle}"
    CloseButtonText="{x:Bind Loc.BtnClose}">

    <Grid MinWidth="560" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Padding="10,5" Click="Copy_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:LucideIcon
                        Kind="Clipboard"
                        Width="14"
                        Height="14"
                        Stroke="{ThemeResource BrushForeground85}"
                        StrokeThickness="1.8" />
                    <TextBlock Text="{x:Bind Loc.BtnCopyLogs}" FontSize="12" />
                </StackPanel>
            </Button>
            <Button Padding="10,5" Click="Clear_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <c:LucideIcon
                        Kind="Trash2"
                        Width="14"
                        Height="14"
                        Stroke="{ThemeResource BrushForeground85}"
                        StrokeThickness="1.8" />
                    <TextBlock Text="{x:Bind Loc.BtnClearLogs}" FontSize="12" />
                </StackPanel>
            </Button>
            <TextBlock
                x:Name="CountText"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource BrushMutedFg80}" />
        </StackPanel>

        <!-- log stream -->
        <Border
            Grid.Row="1"
            Height="380"
            Background="{ThemeResource BrushSubtle}"
            BorderBrush="{ThemeResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8">
            <ListView
                x:Name="LogList"
                ItemsSource="{x:Bind Entries, Mode=OneWay}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            FontFamily="Cascadia Mono, Consolas"
                            FontSize="11"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource BrushForeground90}"
                            Text="{Binding}" />
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="2,1" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Border>
    </Grid>
</ContentDialog>
