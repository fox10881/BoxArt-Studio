<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="GameIconsStudio.Dialogs.GameSearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:GameIconsStudio.Controls"
    xmlns:local="using:GameIconsStudio"
    Title="{x:Bind Loc.DialogTitle}"
    PrimaryButtonText="{x:Bind Loc.DialogPrimary}"
    CloseButtonText="{x:Bind Loc.Cancel}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind HasSelection, Mode=OneWay}">

    <ContentDialog.Resources>
        <local:StringToImageSourceConverter x:Key="StrToImg" />
        <local:BoolToResourceConverter x:Key="BoolRes" />
    </ContentDialog.Resources>

    <Grid MinWidth="430" MinHeight="340" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox
            x:Name="QueryBox"
            Padding="28,0,10,0"
            VerticalContentAlignment="Center"
            Background="{ThemeResource BrushSubtle}"
            BorderBrush="{ThemeResource BrushInput}"
            BorderThickness="1"
            CornerRadius="6"
            FontSize="13"
            PlaceholderText="{x:Bind Loc.SearchDialogPlaceholder}"
            TextChanged="QueryBox_TextChanged" />

        <Grid Grid.Row="1" MaxHeight="300">
            <ListView
                x:Name="ResultsList"
                ItemsSource="{x:Bind Results, Mode=OneWay}"
                SelectionMode="Single"
                SelectionChanged="ResultsList_SelectionChanged"
                IsItemClickEnabled="True"
                ItemClick="ResultsList_ItemClick">
                <ListView.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#1A22D3EE" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#14FFFFFF" />
                                <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#2622D3EE" />
                                <SolidColorBrush x:Key="ListViewItemCheckHintBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemCheckBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ListViewItemSelectionIndicatorBrush" Color="#FF22D3EE" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </ListView.Resources>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="Margin" Value="0,3" />
                        <Setter Property="CornerRadius" Value="8" />
                        <Setter Property="BorderBrush" Value="{ThemeResource BrushBorder}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 2:3 cover thumb with placeholder behind it -->
                            <Border
                                Width="80"
                                Height="120"
                                VerticalAlignment="Top"
                                Background="{ThemeResource BrushSubtle}"
                                BorderBrush="{ThemeResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <c:LucideIcon
                                        Kind="Gamepad"
                                        Width="22"
                                        Height="22"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stroke="{ThemeResource BrushMutedFg80}"
                                        StrokeThickness="1.6" />
                                    <Image
                                        FlowDirection="LeftToRight"
                                        Source="{Binding ThumbUrl, Converter={StaticResource StrToImg}}"
                                        Stretch="UniformToFill" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7">
                                <TextBlock
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource BrushForeground}"
                                    Text="{Binding Title}"
                                    TextWrapping="Wrap" />
                                <TextBlock FontSize="11" Foreground="{ThemeResource BrushMutedForeground}">
                                    <Run Text="SteamGridDB #" /><Run Text="{Binding GameId}" /><Run Text=" · " /><Run Text="{Binding YearLabel}" />
                                </TextBlock>
                                <Border
                                    Padding="8,2"
                                    HorizontalAlignment="Left"
                                    Background="{Binding IsStrongMatch, Converter={StaticResource BoolRes}, ConverterParameter='BrushOkTint|BrushCard'}"
                                    BorderBrush="{Binding IsStrongMatch, Converter={StaticResource BoolRes}, ConverterParameter='BrushOkBorder|BrushBorder'}"
                                    BorderThickness="1"
                                    CornerRadius="999">
                                    <TextBlock
                                        FontSize="10"
                                        FontWeight="Medium"
                                        Foreground="{Binding IsStrongMatch, Converter={StaticResource BoolRes}, ConverterParameter='BrushStatusOk|BrushMutedForeground'}"
                                        Text="{Binding MatchLabel}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Center status when list is empty -->
            <StackPanel
                x:Name="EmptyStatus"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="8">
                <c:LucideIcon
                    Kind="Search"
                    Width="20"
                    Height="20"
                    HorizontalAlignment="Center"
                    Stroke="{ThemeResource BrushMutedForeground}"
                    StrokeThickness="1.8" />
                <TextBlock
                    x:Name="StatusText"
                    FontSize="12"
                    Foreground="{ThemeResource BrushMutedForeground}"
                    Text="{x:Bind Loc.SearchDialogHint}" />
            </StackPanel>
        </Grid>

        <TextBlock
            Grid.Row="2"
            FontSize="11"
            Foreground="{ThemeResource BrushMutedFg80}"
            Text="{x:Bind Loc.SearchDialogFooter}" />
    </Grid>
</ContentDialog>
