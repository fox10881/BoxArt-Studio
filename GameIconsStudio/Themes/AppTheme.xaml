<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette translated 1:1 from app/globals.css -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AppBackground">#FF0D1117</Color>
            <Color x:Key="AppForeground">#FFE6EDF3</Color>
            <Color x:Key="AppCard">#8C161B22</Color>
            <Color x:Key="AppCardHover">#BF1C222B</Color>
            <Color x:Key="AppPopover">#F2161B22</Color>
            <Color x:Key="AppPrimary">#FF22D3EE</Color>
            <Color x:Key="AppPrimaryForeground">#FF04161B</Color>
            <Color x:Key="AppGlow">#FFA78BFA</Color>
            <Color x:Key="AppMuted">#FF161B22</Color>
            <Color x:Key="AppMutedForeground">#FF8B949E</Color>
            <Color x:Key="AppAccentSurface">#FF1C232C</Color>
            <Color x:Key="AppDestructive">#FFF85149</Color>
            <Color x:Key="AppBorder">#14FFFFFF</Color>
            <Color x:Key="AppInput">#1FFFFFFF</Color>
            <Color x:Key="AppTitlebar">#990D1117</Color>
            <Color x:Key="AppSubtle">#0AFFFFFF</Color>
            <Color x:Key="AppSubtleHover">#14FFFFFF</Color>
            <Color x:Key="AppMicaCyan">#1722D3EE</Color>
            <Color x:Key="AppMicaPurple">#1AA78BFA</Color>
            <Color x:Key="AppStatusOk">#FF34D399</Color>
            <Color x:Key="AppStatusWarn">#FFFBBF24</Color>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AppBackground">#FFEEF1F6</Color>
            <Color x:Key="AppForeground">#FF0D1117</Color>
            <Color x:Key="AppCard">#A6FFFFFF</Color>
            <Color x:Key="AppCardHover">#E6FFFFFF</Color>
            <Color x:Key="AppPopover">#FFFFFFFF</Color>
            <Color x:Key="AppPrimary">#FF0891B2</Color>
            <Color x:Key="AppPrimaryForeground">#FFFFFFFF</Color>
            <Color x:Key="AppGlow">#FF7C3AED</Color>
            <Color x:Key="AppMuted">#FFE4E8EF</Color>
            <Color x:Key="AppMutedForeground">#FF57606A</Color>
            <Color x:Key="AppAccentSurface">#FFE4E8EF</Color>
            <Color x:Key="AppDestructive">#FFC42B1C</Color>
            <Color x:Key="AppBorder">#1A0D1117</Color>
            <Color x:Key="AppInput">#1F0D1117</Color>
            <Color x:Key="AppTitlebar">#8CFFFFFF</Color>
            <Color x:Key="AppSubtle">#080D1117</Color>
            <Color x:Key="AppSubtleHover">#120D1117</Color>
            <Color x:Key="AppMicaCyan">#1F0891B2</Color>
            <Color x:Key="AppMicaPurple">#1A7C3AED</Color>
            <Color x:Key="AppStatusOk">#FF059669</Color>
            <Color x:Key="AppStatusWarn">#FFD97706</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BrushBackground" Color="{ThemeResource AppBackground}" />
    <SolidColorBrush x:Key="BrushForeground" Color="{ThemeResource AppForeground}" />
    <SolidColorBrush x:Key="BrushCard" Color="{ThemeResource AppCard}" />
    <SolidColorBrush x:Key="BrushCardHover" Color="{ThemeResource AppCardHover}" />
    <SolidColorBrush x:Key="BrushPopover" Color="{ThemeResource AppPopover}" />
    <SolidColorBrush x:Key="BrushPrimary" Color="{ThemeResource AppPrimary}" />
    <SolidColorBrush x:Key="BrushPrimaryForeground" Color="{ThemeResource AppPrimaryForeground}" />
    <SolidColorBrush x:Key="BrushGlow" Color="{ThemeResource AppGlow}" />
    <SolidColorBrush x:Key="BrushMuted" Color="{ThemeResource AppMuted}" />
    <SolidColorBrush x:Key="BrushMutedForeground" Color="{ThemeResource AppMutedForeground}" />
    <SolidColorBrush x:Key="BrushAccentSurface" Color="{ThemeResource AppAccentSurface}" />
    <SolidColorBrush x:Key="BrushDestructive" Color="{ThemeResource AppDestructive}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{ThemeResource AppBorder}" />
    <SolidColorBrush x:Key="BrushInput" Color="{ThemeResource AppInput}" />
    <SolidColorBrush x:Key="BrushTitlebar" Color="{ThemeResource AppTitlebar}" />
    <SolidColorBrush x:Key="BrushSubtle" Color="{ThemeResource AppSubtle}" />
    <SolidColorBrush x:Key="BrushSubtleHover" Color="{ThemeResource AppSubtleHover}" />
    <SolidColorBrush x:Key="BrushStatusOk" Color="{ThemeResource AppStatusOk}" />
    <SolidColorBrush x:Key="BrushStatusWarn" Color="{ThemeResource AppStatusWarn}" />

    <!-- Brand gradient: primary -> glow -->
    <LinearGradientBrush x:Key="BrushBrandGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="{ThemeResource AppPrimary}" Offset="0" />
        <GradientStop Color="{ThemeResource AppGlow}" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushBrandGradientVertical" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{ThemeResource AppPrimary}" Offset="0" />
        <GradientStop Color="{ThemeResource AppGlow}" Offset="1" />
    </LinearGradientBrush>

    <!-- Steelbook metal gradient (135deg) from cover-frame.tsx -->
    <LinearGradientBrush x:Key="BrushSteelbook" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFF4F4F5" Offset="0" />
        <GradientStop Color="#FFA1A1AA" Offset="0.22" />
        <GradientStop Color="#FF52525B" Offset="0.45" />
        <GradientStop Color="#FFD4D4D8" Offset="0.62" />
        <GradientStop Color="#FF71717A" Offset="0.80" />
        <GradientStop Color="#FFE4E4E7" Offset="1" />
    </LinearGradientBrush>

    <!-- Steelbook sheen sweep (115deg) -->
    <LinearGradientBrush x:Key="BrushSteelbookSheen" StartPoint="0.29,0" EndPoint="0.71,1">
        <GradientStop Color="#00FFFFFF" Offset="0.25" />
        <GradientStop Color="#47FFFFFF" Offset="0.42" />
        <GradientStop Color="#00FFFFFF" Offset="0.52" />
        <GradientStop Color="#00FFFFFF" Offset="0.68" />
        <GradientStop Color="#1FFFFFFF" Offset="0.78" />
        <GradientStop Color="#00FFFFFF" Offset="0.86" />
    </LinearGradientBrush>

    <!-- Ambient mica tints (radial washes over the window) -->
    <RadialGradientBrush x:Key="BrushMicaPurpleWash" Center="0.85,-0.10" RadiusX="0.6" RadiusY="0.6">
        <GradientStop Color="{ThemeResource AppMicaPurple}" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.6" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BrushMicaCyanWash" Center="0,1.10" RadiusX="0.5" RadiusY="0.6">
        <GradientStop Color="{ThemeResource AppMicaCyan}" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.6" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="BrushCoverHalo" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="{ThemeResource AppMicaCyan}" Offset="0" />
        <GradientStop Color="#00FFFFFF" Offset="0.7" />
    </RadialGradientBrush>

    <!-- Pills / soft tints -->
    <SolidColorBrush x:Key="BrushPrimaryTint" Color="{ThemeResource AppPrimary}" Opacity="0.10" />
    <SolidColorBrush x:Key="BrushGlowTint" Color="{ThemeResource AppGlow}" Opacity="0.10" />
    <SolidColorBrush x:Key="BrushOkTint" Color="{ThemeResource AppStatusOk}" Opacity="0.10" />
    <SolidColorBrush x:Key="BrushWarnTint" Color="{ThemeResource AppStatusWarn}" Opacity="0.10" />
    <SolidColorBrush x:Key="BrushPrimaryBorder" Color="{ThemeResource AppPrimary}" Opacity="0.40" />
    <SolidColorBrush x:Key="BrushPrimaryBorderSoft" Color="{ThemeResource AppPrimary}" Opacity="0.25" />
    <SolidColorBrush x:Key="BrushOkBorder" Color="{ThemeResource AppStatusOk}" Opacity="0.30" />
    <SolidColorBrush x:Key="BrushWarnBorder" Color="{ThemeResource AppStatusWarn}" Opacity="0.30" />
    <SolidColorBrush x:Key="BrushGlowBorder" Color="{ThemeResource AppGlow}" Opacity="0.30" />
    <SolidColorBrush x:Key="BrushForeground85" Color="{ThemeResource AppForeground}" Opacity="0.85" />
    <SolidColorBrush x:Key="BrushForeground90" Color="{ThemeResource AppForeground}" Opacity="0.90" />
    <SolidColorBrush x:Key="BrushMutedFg80" Color="{ThemeResource AppMutedForeground}" Opacity="0.80" />

    <!-- Section heading style: 11px semibold uppercase tracked-out -->
    <Style x:Key="SectionHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource BrushMutedForeground}" />
        <Setter Property="CharacterSpacing" Value="140" />
    </Style>

    <!-- Ghost button (subtle surface, bordered) -->
    <Style x:Key="GhostButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource BrushSubtle}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BrushBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
</ResourceDictionary>
